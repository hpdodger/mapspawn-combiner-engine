::AlwaysBindGameEventDispatchers <- function() {
    foreach ( ev in ::g_AlwaysGameEventNames ) {
        local hook = "OnGameEvent_" + ev;
        local env = { hook = hook };
        local fwd = function( params ) {
            ::AlwaysDispatchEvent( this.hook, params );
        };
        getroottable()[hook] <- fwd.bindenv( env );
    }
    printl( "[Always] bound " + ::g_AlwaysGameEventNames.len() + " OnGameEvent_* dispatchers" );
};
