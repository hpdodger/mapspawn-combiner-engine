// mapspawn_combiner/modules/detailed_death_message/strings.nut
// Словари en/ru. Английские формулировки — как у jhh8 (detailed-death-message).
// Русские имена сущностей — в творительном падеже: вставляются после причастия
// («был изрублен дроном», «своим дробовиком»).

::DdmI18n <- {
    msg = {
        lead = {
            en = "%s1 was ",
            ru = "%s1 был ",
        },
        event_typed = {
            en = "{type} by {killer}",
            ru = "{type} {killer}",
        },
        event_plain = {
            en = "{killer}",
            ru = "{killer}",
        },
        his_thing = {
            en = "his {thing}",
            ru = "своим {thing}",
        },
        whose_thing = {
            en = "{who}'s {thing}",
            ru = "{thing} ({who})",
        },
        himself = {
            en = "himself",
            ru = "самим собой",
        },
        set_on_fire = {
            en = "set on fire",
            ru = "подожжён",
        },
        killed_by_fire = {
            en = "killed by fire",
            ru = "убит огнём",
        },
        finally_joiner = {
            en = " and finally ",
            ru = " и в итоге ",
        },
        end = {
            en = ".",
            ru = ".",
        },
    },

    joiners = [
        { en = " then ", ru = ", затем " },
        { en = ", ",     ru = ", " },
        { en = " and ",  ru = " и " },
    ],

